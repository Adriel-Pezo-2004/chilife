generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model LifeMonth {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  monthKey      String
  userId        String?             @db.ObjectId
  user          User?               @relation(fields: [userId], references: [id])
  categories    LifeCategory[]
  dailyProgress DailyAreaProgress[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, monthKey])
}

model LifeCategory {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  monthId   String    @db.ObjectId
  month     LifeMonth @relation(fields: [monthId], references: [id])
  key       String
  goal      Int
  progress  Int       @default(0)
  budget    Int       @default(0)
  updatedAt DateTime  @updatedAt

  @@unique([monthId, key])
}

model User {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String      @unique
  passwordHash String
  months       LifeMonth[]
  dailyTasks   DailyTask[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model DailyTask {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  dateKey         String
  categoryKey     String
  description     String
  progressPercent Int      @default(0)
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, dateKey])
}

model DailyAreaProgress {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  monthId     String    @db.ObjectId
  month       LifeMonth @relation(fields: [monthId], references: [id])
  categoryKey String
  dateKey     String
  createdAt   DateTime  @default(now())

  @@unique([monthId, categoryKey, dateKey])
  @@index([monthId, dateKey])
}
